#define ZMK_POINTING_DEFAULT_SCRL_VAL 300

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        mousescroll: mousescroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            label = "base";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE        &kp N1  &kp N2  &kp N3  &kp N4        &kp N5     &kp N6      &kp N7        &kp N8     &kp N9    &kp N0    &kp BACKSPACE
&kp TAB           &kp Q   &kp W   &kp E   &kp R         &kp T      &kp Y       &kp U         &kp I      &kp O     &kp P     &kp DELETE
&kp LEFT_SHIFT    &kp A   &kp S   &kp D   &kp F         &kp G      &kp H       &kp J         &kp K      &kp L     &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C   &kp V         &kp B      &kp N       &kp M         &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp C_MUTE        &none   &none   &mo 2   &kp LEFT_WIN  &kp SPACE  &kp RETURN  &kp LEFT_ALT  &mo 1      &none     &none
                                                                   &kp ENTER   &kp RIGHT     &kp UP     &kp LEFT  &kp DOWN
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        function_keys {
            label = "fn";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp F1  &kp F2        &kp F3           &kp F4          &kp F5          &kp F6  &kp F7         &kp F8          &kp F9          &kp F10          &kp F11  &kp F12
&trans  &none         &none            &none           &none           &none   &kp PAGE_UP    &kp DEL         &kp UP_ARROW    &kp HOME         &none    &none
&trans  &kp LEFT_ALT  &kp LEFT_GUI     &kp LEFT_SHIFT  &kp LCTRL       &none   &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none    &none
&trans  &none         &kp PRINTSCREEN  &kp CAPSLOCK    &kp KP_NUMLOCK  &none   &kp ENTER      &kp BACKSPACE   &kp TAB         &kp END          &none    &trans
&trans  &trans        &trans           &mo 3           &trans          &trans  &trans         &trans          &trans          &trans           &trans
                                                                               &trans         &trans          &trans          &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        symbols {
            label = "sym";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&kp F1  &kp F2    &kp F3         &kp F4        &kp F5            &kp F6  &kp F7        &kp F8                 &kp F9           &kp F10            &kp F11        &kp F12
&trans  &none     &kp UNDER      &kp KP_MINUS  &kp KP_PLUS       &none   &none         &kp GRAVE              &kp TILDE        &kp KP_EQUAL       &kp PIPE       &none
&trans  &kp LALT  &kp LEFT_GUI   &kp LSHFT     &kp LEFT_CONTROL  &none   &kp QUESTION  &kp LEFT_PARENTHESIS   &kp LEFT_BRACE   &kp LEFT_BRACKET   &kp AMPERSAND  &none
&trans  &none     &kp BACKSLASH  &kp PIPE      &kp AMPERSAND     &none   &kp EXCL      &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
&trans  &trans    &trans         &none         &trans            &trans  &trans        &trans                 &mo 3            &trans             &trans
                                                                         &trans        &trans                 &trans           &trans             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        media_and_bt {
            bindings = <
&none   &none         &none         &none                 &none                 &none   &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none   &kp K_STOP    &kp K_PREV    &kp K_PLAY_PAUSE      &kp K_NEXT            &none   &none       &none         &none         &none         &none         &none
&trans  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT        &kp LEFT_CONTROL      &none   &none       &tog 4        &none         &none         &none         &none
&trans  &none         &none         &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none   &none       &none         &none         &none         &none         &none
&trans  &none         &none         &none                 &trans                &trans  &trans      &trans        &none         &none         &none
                                                                                        &trans      &trans        &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            label = "media_bt";
        };

        game {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            label = "game";
            bindings = <
&kp ESC     &kp N1  &kp N2  &kp N3        &kp N4     &kp N5     &kp N6     &kp N7        &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB     &kp Q   &kp W   &kp E         &kp R      &kp T      &kp Y      &kp U         &kp I      &kp O    &kp P     &kp DELETE
&kp LSHFT   &kp A   &kp S   &kp D         &kp F      &kp G      &kp H      &kp J         &kp K      &kp L    &kp SEMI  &kp APOS
&kp LCTRL   &kp Z   &kp X   &kp C         &kp V      &kp B      &kp N      &kp M         &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&kp K_MUTE  &none   &none   &kp LEFT_ALT  &kp SPACE  &kp SPACE  &kp ENTER  &kp LEFT_GUI  &mo 5      &none    &none
                                                                &tog 0     &trans        &trans     &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        gaming_support {
            bindings = <
&kp F1  &kp F2    &kp F3    &kp F4     &kp F5     &kp F6  &kp F7  &kp F8          &kp F9          &kp F10    &kp F11  &kp F12
&trans  &none     &none     &none      &none      &none   &none   &kp INSERT      &kp UP_ARROW    &kp HOME   &none    &none
&trans  &kp LALT  &kp LGUI  &kp LSHFT  &kp LCTRL  &none   &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &none    &none
&trans  &none     &none     &none      &none      &none   &none   &none           &none           &none      &none    &trans
&trans  &none     &none     &none      &trans     &trans  &trans  &trans          &none           &none      &none
                                                          &trans  &trans          &trans          &trans     &trans
            >;

            label = "game sup";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };
};
